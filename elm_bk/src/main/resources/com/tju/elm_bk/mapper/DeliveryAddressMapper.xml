<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.tju.elm_bk.mapper.DeliveryAddressMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO delivery_address (contact_name,contact_sex,contact_tel,address,user_id,creator,updater,is_deleted,create_time,update_time)
        VALUES (#{contactName},#{contactSex},#{contactTel},#{address},#{userId},#{creator},#{updater},#{isDeleted},#{createTime},#{updateTime})
    </insert>
</mapper>